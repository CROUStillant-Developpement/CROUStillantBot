# Ce fichier est un exemple de fichier .env
ENV=

# BOT TOKEN
TOKEN=

# Serveur Discord URL
DISCORD_INVITE_URL=https://discord.gg/yG6FjqbWtk

# PostgreSQL
POSTGRES_DATABASE=CROUStillant
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API de statut (dPyStatus) : GET http://<host>:<port><path>
DPYSTATUS_HOST=0.0.0.0
DPYSTATUS_PORT=8080
DPYSTATUS_PATH=/status
DPYSTATUS_TOKEN=

# API CROUStillant (flux des événements en temps réel : GET /v1/evenements)
API_URL=https://api.croustillant.menu
